const { polygon } = require('@jscad/modeling').primitives
const { extrudeLinear } = require('@jscad/modeling').extrusions
const { scale } = require('@jscad/modeling').transforms

// Acid badge: the classic acid-house smiley (from the supplied
// bad-smiley-bw.svg), with:
//  - the 24-hole mouth arc from the first acid-badge design, now
//    following the mouth's own local middle (variable radius from the
//    face center) instead of sitting on one constant-radius arc
//  - a 5.1mm push-fit hole (5mm + 0.1mm tolerance) through each eye,
//    centered on that eye's own area-weighted centroid
//
// The SVG's single evenodd path has 5 subpaths -- traced (bezier
// curves flattened to 8 line segments each) and combined offline (see
// scratch-build-v2.js, not part of this file's own build) into the 4
// point loops below:
//   RING_LOOP_POINTS -- the face's circular outline, drawn as 2 nested
//     circles (a "stroke", not a filled disc) in the SVG; the outer
//     and inner boundaries are merged into ONE simple loop via a
//     keyhole bridge (a thin double-backed slit connecting them), so
//     no hole-cutting boolean is needed to build it
//   MOUTH_WITH_HOLES_LOOP_POINTS -- the mouth (an organic crescent, NOT
//     a plain arc at a fixed radius from the face center) with the 24
//     holes below punched into it, all merged into ONE simple loop the
//     same keyhole way
//   EYE_LEFT_LOOP_POINTS / EYE_RIGHT_LOOP_POINTS -- the 2 eyes, each
//     with its own push-fit hole merged in the same keyhole way
//
// These 4 loops are disjoint (none of them touch), so the finished
// badge is exported as 4 separate solids rather than one CSG-unioned
// shape -- see OPENJSCAD_SKILL.md for why (jscad's own 2D booleans
// silently mishandle concave-vs-concave combinations like these).
//
// How the 24 mouth holes are placed: for a dense set of angles from
// the face's own center, a ray is cast through the mouth's traced
// outline; the MIDPOINT of that ray's entry/exit crossing becomes a
// sample of the mouth's local "centerline", and the crossing's own
// half-length is a first-pass thickness estimate at that sample. The
// 24 holes are then walked along that centerline by true chord
// distance (not raw arc length) so consecutive hole centers really are
// HOLE_SPACING_MM apart in a straight line. Each candidate placement
// (and the window of centerline it's allowed to live in) is verified
// against the mouth's ACTUAL nearest-boundary distance in every
// direction, not just along the radial ray -- the radial reading alone
// under-detects risk near the crescent's pointed tips, where the
// boundary isn't perpendicular to the ray (found by an off-by-2 hole
// count during a first pass: 2 of the 24 candidate holes silently
// touched/merged into the mouth's outer boundary because the ends of
// the walked path landed right at those tips). The largest hole
// spacing that still leaves MARGIN_MM of material on every side, for
// every one of the 24 holes, pins down the whole badge's scale
// (SCALE_MM_PER_SVG_UNIT below) -- same principle as the previous
// design's constant-radius arc, just measured along a curve instead of
// a circle.
//
// Eye holes: each eye's own area-weighted centroid (not just its
// bounding-box center) is the hole center; the full hole circle is
// checked against the eye's true nearest-boundary distance in every
// direction the same way, with wide margin to spare (eyes are much
// bigger than the mouth relative to a single 5.1mm hole).

const THICKNESS = 3 // extrusion height
const SCALE_MM_PER_SVG_UNIT = 0.347943465876992
// = HOLE_SPACING_MM(5) / chord distance between adjacent mouth holes
// walked along the mouth's local centerline (see scratch-build-v2.js)

