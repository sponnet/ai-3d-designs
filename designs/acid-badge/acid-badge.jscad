const { polygon } = require('@jscad/modeling').primitives
const { extrudeLinear } = require('@jscad/modeling').extrusions
const { scale } = require('@jscad/modeling').transforms

// Acid badge: the classic acid-house smiley (from the supplied
// bad-smiley-bw.svg), printable as ONE connected piece.
//
// The SVG's single evenodd path has 5 subpaths (face ring as 2 nested
// circles, 2 eyes, 1 mouth) -- traced (bezier curves flattened to 8
// line segments each) and combined offline (see scratch-build-v4.js,
// not part of this file's own build) into a single point loop:
//   - the face ring (outer/inner boundary)
//   - the mouth, with 24 x 3.1mm holes following its own local
//     centerline (variable radius from the face center), 5mm apart
//     (true chord distance), at least 1mm material on every side
//   - each eye, with a 5.1mm push-fit hole (5mm + 0.1mm tolerance) on
//     its own area-weighted centroid
//   - connecting strips holding everything to the ring: 4 for the
//     mouth, 3 for each eye. Each strip narrows to 1mm exactly at the
//     2 points ("snijpunten") where it meets the ring and the
//     satellite shape, so it snaps off cleanly by hand after printing.
//     Ring-side attachment points are spread evenly by ANGLE from the
//     face center (not just "nearest point on the ring", which
//     clusters badly for a small shape near a much bigger ring), and
//     satellite-side points are kept apart too -- otherwise adjacent
//     strips can end up anchored almost on top of each other.
//   Between any 2 adjacent strips into the same shape there's a small
//   fully-enclosed pocket of open air (topologically unavoidable once
//   a shape is tied to the ring by more than 1 strip -- each extra
//   strip beyond the first closes off one more such pocket). That's
//   expected, not a defect: it's just empty space, like the gaps
//   between the prongs of a fork.
//
// All of this (ring + strips + mouth-with-holes + both eyes-with-
// holes) is combined offline with the polygon-clipping npm package
// (jscad's own 2D booleans mishandle concave-vs-concave combinations
// like these -- see OPENJSCAD_SKILL.md), then every resulting hole is
// merged into the single exterior with a keyhole bridge (a thin
// double-backed slit), producing ONE simple point loop that needs no
// jscad boolean operations at all -- just polygon() + extrudeLinear().

const THICKNESS = 2 // extrusion height
const SCALE_MM_PER_SVG_UNIT = 0.34847915648910127
// = HOLE_SPACING_MM(5) / chord distance between adjacent mouth holes
// walked along the mouth's local centerline (see scratch-build-v4.js)

