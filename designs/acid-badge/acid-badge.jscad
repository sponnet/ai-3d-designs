const { polygon } = require('@jscad/modeling').primitives
const { extrudeLinear } = require('@jscad/modeling').extrusions
const { scale } = require('@jscad/modeling').transforms

// Acid badge: the classic acid-house smiley (from the supplied
// bad-smiley-bw.svg), with the 24-hole arc from the first acid-badge
// design punched through its mouth.
//
// The SVG's single evenodd path has 5 subpaths -- traced (bezier
// curves flattened to 8 line segments each) and combined offline (see
// scratch-final-build.js, not part of this file's own build) into the
// 4 point loops below:
//   RING_LOOP_POINTS -- the face's circular outline, drawn as 2 nested
//     circles (a "stroke", not a filled disc) in the SVG; the outer
//     and inner boundaries are merged into ONE simple loop via a
//     keyhole bridge (a thin double-backed slit connecting them), so
//     no hole-cutting boolean is needed to build it
//   MOUTH_WITH_HOLES_LOOP_POINTS -- the mouth (an organic crescent, NOT
//     a plain arc at a fixed radius from the face center) with the 24
//     holes below punched into it, all merged into ONE simple loop the
//     same keyhole way
//   EYE_LEFT_LOOP_POINTS / EYE_RIGHT_LOOP_POINTS -- the 2 eyes, plain
//     (no holes, no merging needed)
//
// These 4 loops are disjoint (none of them touch), so the finished
// badge is exported as 4 separate solids rather than one CSG-unioned
// shape -- see "Real bug found building this" below for why.
//
// The 24 holes (HOLE_DIAMETER, HOLE_SPACING as given) sit along an arc
// centered on the outer face circle's own center (as asked -- "radiaal
// ... ten opzichte van het centrum van de buitenste cirkel"), at a
// radius and angular span chosen so every hole fits inside the mouth's
// actual outline (checked point-by-point around each hole's own
// circumference, not just its center, against the traced mouth
// outline -- done offline, not re-derived here). That radius/span pin
// down the scale (SCALE_MM_PER_SVG_UNIT below) everything else has to
// be built at: the chord length between adjacent holes at that
// radius/span has to become exactly HOLE_SPACING_MM once scaled.
//
// The point loops are already in final SVG units, centered on the
// face's own center; SCALE_MM_PER_SVG_UNIT converts that to mm right
// before extrusion.

const THICKNESS = 3 // assumed -- extrusion height, matches the first acid-badge design
const SCALE_MM_PER_SVG_UNIT = 0.3540178278262263 // = HOLE_SPACING_MM(5) / chord length
// between adjacent holes at ARC_RADIUS_SVG=140, ARC_SPAN_DEG=133 (see scratch-final-build.js)

